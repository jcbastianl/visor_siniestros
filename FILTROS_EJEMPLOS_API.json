{
  "titulo": "Ejemplos de Uso - Filtros Avanzados API",
  "version": "1.0",
  "descripcion": "Colección de ejemplos de requests con filtros avanzados para django-filter",
  "ejemplos_siniestros": {
    "filtro_basico": {
      "descripcion": "Obtener todos los siniestros del 2024",
      "endpoint": "GET /api/siniestros/",
      "parametros": {
        "fecha_hora__year": 2024
      },
      "url_completa": "http://127.0.0.1:8002/api/siniestros/?fecha_hora__year=2024"
    },
    "filtro_temporal_completo": {
      "descripcion": "Siniestros de jueves a las 15 horas en junio de 2024",
      "endpoint": "GET /api/siniestros/",
      "parametros": {
        "fecha_hora__year": 2024,
        "fecha_hora__month": 6,
        "fecha_hora__week_day": 5,
        "fecha_hora__hour": 15
      },
      "url_completa": "http://127.0.0.1:8002/api/siniestros/?fecha_hora__year=2024&fecha_hora__month=6&fecha_hora__week_day=5&fecha_hora__hour=15"
    },
    "filtro_por_severidad": {
      "descripcion": "Siniestros graves de 2024",
      "endpoint": "GET /api/siniestros/",
      "parametros": {
        "fecha_hora__year": 2024,
        "grado_severidad": "GRAVE"
      },
      "url_completa": "http://127.0.0.1:8002/api/siniestros/?fecha_hora__year=2024&grado_severidad=GRAVE"
    },
    "filtro_por_causas": {
      "descripcion": "Siniestros por causa probable (ID=1) en 2024",
      "endpoint": "GET /api/siniestros/",
      "parametros": {
        "fecha_hora__year": 2024,
        "causa_probable": 1
      },
      "url_completa": "http://127.0.0.1:8002/api/siniestros/?fecha_hora__year=2024&causa_probable=1"
    },
    "filtro_busqueda_via": {
      "descripcion": "Siniestros en vías que contengan 'carrera'",
      "endpoint": "GET /api/siniestros/",
      "parametros": {
        "via": "carrera"
      },
      "url_completa": "http://127.0.0.1:8002/api/siniestros/?via=carrera"
    },
    "filtro_rango_años": {
      "descripcion": "Siniestros entre 2022 y 2024",
      "endpoint": "GET /api/siniestros/",
      "parametros": {
        "fecha_hora__year_range_min": 2022,
        "fecha_hora__year_range_max": 2024
      },
      "url_completa": "http://127.0.0.1:8002/api/siniestros/?fecha_hora__year_range_min=2022&fecha_hora__year_range_max=2024"
    },
    "estadisticas_filtradas_por_mes": {
      "descripcion": "Estadísticas mensuales de siniestros graves en 2024",
      "endpoint": "GET /api/siniestros/por_mes/",
      "parametros": {
        "fecha_hora__year": 2024,
        "grado_severidad": "GRAVE"
      },
      "url_completa": "http://127.0.0.1:8002/api/siniestros/por_mes/?fecha_hora__year=2024&grado_severidad=GRAVE"
    },
    "estadisticas_por_via_filtradas": {
      "descripcion": "Top vías para siniestros críticos de 2024",
      "endpoint": "GET /api/siniestros/por_via/",
      "parametros": {
        "fecha_hora__year": 2024,
        "grado_severidad": "CRITICO"
      },
      "url_completa": "http://127.0.0.1:8002/api/siniestros/por_via/?fecha_hora__year=2024&grado_severidad=CRITICO"
    }
  },
  "ejemplos_victimas": {
    "lista_basica": {
