      "descripcion": "Peatones menores de 18 años",
      "endpoint": "GET /api/victimas/",
      "parametros": {
        "actor_vial": "PEATÓN",
        "edad_max": 17
      },
      "url_completa": "http://127.0.0.1:8002/api/victimas/?actor_vial=PEATÓN&edad_max=17"
    },
    "filtro_rango_edad": {
      "descripcion": "Víctimas adultas (18-65 años) en 2024",
      "endpoint": "GET /api/victimas/",
      "parametros": {
        "siniestro__fecha_hora__year": 2024,
        "edad_min": 18,
        "edad_max": 65
      },
      "url_completa": "http://127.0.0.1:8002/api/victimas/?siniestro__fecha_hora__year=2024&edad_min=18&edad_max=65"
    },
    "filtro_complejo": {
      "descripcion": "Hombres fallecidos peatones en siniestros de 2024",
      "endpoint": "GET /api/victimas/",
      "parametros": {
        "siniestro__fecha_hora__year": 2024,
        "sexo": "M",
        "condicion": "FALLECIDO",
        "actor_vial": "PEATÓN"
      },
      "url_completa": "http://127.0.0.1:8002/api/victimas/?siniestro__fecha_hora__year=2024&sexo=M&condicion=FALLECIDO&actor_vial=PEATÓN"
    },
    "estadisticas_filtradas": {
      "descripcion": "Evolución anual de víctimas peatones",
      "endpoint": "GET /api/victimas/evolucion_anual/",
      "parametros": {
        "actor_vial": "PEATÓN"
      },
      "url_completa": "http://127.0.0.1:8002/api/victimas/evolucion_anual/?actor_vial=PEATÓN"
    },
    "estadisticas_por_sexo_filtradas": {
      "descripcion": "Distribución por sexo de víctimas en 2024",
      "endpoint": "GET /api/victimas/por_sexo/",
      "parametros": {
        "siniestro__fecha_hora__year": 2024
      },
      "url_completa": "http://127.0.0.1:8002/api/victimas/por_sexo/?siniestro__fecha_hora__year=2024"
    }
  },
  "valores_enumerados": {
    "dias_semana": {
      "1": "Domingo",
      "2": "Lunes",
      "3": "Martes",
      "4": "Miércoles",
      "5": "Jueves",
      "6": "Viernes",
      "7": "Sábado"
    },
    "severidad": [
      "LEVE",
      "MODERADO",
      "GRAVE",
      "CRITICO"
    ],
    "sexo": {
      "M": "Masculino",
      "F": "Femenino",
      "O": "Otro"
    },
    "condicion": [
      "LESIONADO",
