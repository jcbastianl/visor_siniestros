    "horas": "0-23 (representan rangos horarios, ej: 15 = 15:00-15:59)"
  },
  "notes": {
    "combinacion_filtros": "Todos los filtros se combinan con lógica AND (todas las condiciones deben cumplirse)",
    "case_sensitivity": "Los valores enum (severidad, sexo, etc.) son case-sensitive, use MAYÚSCULAS",
    "paginacion": "Los filtros funcionan con paginación: ?fecha_hora__year=2024&limit=50&offset=0",
    "performance": "Los filtros se aplican a nivel de base de datos para optimizar performance"
