    },
    "filtro_por_sexo": {
      "descripcion": "Víctimas femeninas del 2024",
      "endpoint": "GET /api/victimas/",
      "parametros": {
        "siniestro__fecha_hora__year": 2024,
        "sexo": "F"
      },
      "url_completa": "http://127.0.0.1:8002/api/victimas/?siniestro__fecha_hora__year=2024&sexo=F"
    },
    "filtro_por_condicion": {
      "descripcion": "Víctimas fallecidas en 2024",
      "endpoint": "GET /api/victimas/",
      "parametros": {
        "siniestro__fecha_hora__year": 2024,
        "condicion": "FALLECIDO"
      },
      "url_completa": "http://127.0.0.1:8002/api/victimas/?siniestro__fecha_hora__year=2024&condicion=FALLECIDO"
    },
