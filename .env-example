# =============================================================================
# Visor de Siniestros — Plantilla de Variables de Entorno
# =============================================================================
# Copia este archivo como ".env" y rellena los valores.
#   cp .env-example .env
#
# En producción (Render, Railway, etc.) configura estas variables
# directamente en el panel del proveedor.

# --- Django Core ---
# Genera una clave secreta única para producción:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-en-produccion
DEBUG=False
ALLOWED_HOSTS=tu-dominio.onrender.com

# --- Base de Datos (PostgreSQL) ---
# Formato: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/visor_siniestros

# --- CORS y CSRF (obligatorio si el frontend está en otro dominio) ---
# Orígenes del frontend, separados por coma (sin espacios)
# Ej. Static Web App: https://purple-tree-0b01a5c0f.azurestaticapps.net
# Ej. dev local: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=https://tu-frontend.azurestaticapps.net,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://tu-frontend.azurestaticapps.net

# --- Superusuario (para deploy automático con build.sh) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=contraseña-segura
